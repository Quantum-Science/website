{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true
	},
	"include": [
		"src",
		"test",
		"*"
	],
	"exclude": [
		"src/service-worker"
	]
}